# embedx container configuration. Copy to .env and edit:
#   cp .env.example .env
#
# .env is gitignored and read by docker compose. Every EMBEDX_* variable
# maps to a field on Settings; see `embedx info` for the resolved values and
# DEPLOY.md for the full list.

# --------------------------------------------------------------------------- #
# Identity of the container process
# --------------------------------------------------------------------------- #
# Must own the cache directories mounted in docker-compose.yml, or Triton
# cannot write its kernel cache and every request fails at first inference.
# Set these to your own ids:  id -u  /  id -g
EMBEDX_UID=1000
EMBEDX_GID=1000

# --------------------------------------------------------------------------- #
# Image
# --------------------------------------------------------------------------- #
# Which published image compose pulls. The default is Docker Hub. The same
# image is on GHCR, which does NOT rate-limit anonymous pulls -- switch to it
# if you hit Docker Hub's limit, which is counted per source IP and so is much
# easier to reach from CI or behind shared NAT than from a workstation.
# EMBEDX_IMAGE=ghcr.io/gabintb/embedx:0.3.1

# --------------------------------------------------------------------------- #
# Storage
# --------------------------------------------------------------------------- #
# Put these on fast local storage. The disk read is the largest single stage
# of a cold model load (68% of it, measured), so a slow or networked path
# here is the one way containerization costs measurable throughput.
EMBEDX_HF_CACHE=./cache/hf
EMBEDX_TRITON_CACHE=./cache/triton

# --------------------------------------------------------------------------- #
# Network
# --------------------------------------------------------------------------- #
# Host-side port. Published to 127.0.0.1 only; see docker-compose.yml.
EMBEDX_PUBLISH_PORT=8477

# Bearer token. STRONGLY recommended even on loopback: without it, any local
# process or container on the host can submit work and evict your models.
# EMBEDX_API_KEY=change-me

# --------------------------------------------------------------------------- #
# Serving
# --------------------------------------------------------------------------- #
# Models are named per request, not configured here. There is no model id.

# Which GPUs to use, by index, e.g. "0" or "0,1". Leave unset for all that
# the container can see. Read the DEPLOY.md section on how this interacts
# with CUDA_VISIBLE_DEVICES and compose's device_ids before setting it.
# EMBEDX_DEVICES=0,1

# Idle seconds before a model is unloaded. 600 is measured, not guessed: a
# cold reload costs 9.36s against 2.98s warm, so 600s puts the worst-case
# reload overhead at 1.6% of an idle window (15.6% at 60s).
# EMBEDX_DEFAULT_KEEP_ALIVE_S=600

# Cap on resident models. Unset means no cap; at the cap the least recently
# used unreferenced model is evicted.
# EMBEDX_MAX_LOADED_MODELS=2

# Admission control. Requests and cold loads are capped separately on
# purpose -- merging them would let slow loads starve warm requests.
# EMBEDX_MAX_CONCURRENT_REQUESTS=8
# EMBEDX_MAX_CONCURRENT_LOADS=2
# EMBEDX_REQUEST_QUEUE_TIMEOUT_S=30

# L2-normalize output vectors.
# EMBEDX_NORMALIZE=true

# DEBUG, INFO, WARNING, ERROR, CRITICAL
# EMBEDX_LOG_LEVEL=INFO
